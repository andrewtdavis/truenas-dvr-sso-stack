# Example environment values referenced in the docs. Do NOT commit a filled copy.
# Timezone for all containers
TZ=America/Los_Angeles

# UID/GID that owns media + app configs (the unprivileged app user)
PUID=1000
PGID=1000

# SWAG / reverse proxy
DOMAIN=example.com
# DNS provider for the DNS-01 ACME challenge (cloudflare shown; see SWAG docs for others)
DNSPLUGIN=cloudflare
